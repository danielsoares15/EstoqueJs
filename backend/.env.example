# Porta da aplicação backend
PORT=3001

# Ambiente de execução: development ou production
NODE_ENV=development

# Origens permitidas para CORS (separadas por vírgula em produção)
CORS_ORIGIN=http://localhost:5173

# Caminho do banco de dados SQLite (deixe vazio para usar ./estoque.db)
DB_PATH=

# Chave secreta para assinatura dos tokens JWT/HMAC (obrigatório em produção)
JWT_SECRET=sua_chave_secreta_super_segura_aqui

# Tempo de expiração da sessão em minutos
SESSION_TIMEOUT_MINUTES=60

# Credenciais do Administrador inicial
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
